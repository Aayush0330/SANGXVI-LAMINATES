# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional shadow database used only by `prisma migrate dev`.
SHADOW_DATABASE_URL=""

# Authentication and scheduled jobs
# Generate with: openssl rand -hex 32
CRON_SECRET=""
DATABASE_POOL_MAX="10"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="10000"

# Attendance GPS quality gate (metres)
ATTENDANCE_MAX_ACCURACY_METERS="150"

# Field live-location controls
FIELD_LOCATION_MAX_ACCURACY_METERS="150"
FIELD_LOCATION_MIN_INTERVAL_MS="20000"
FIELD_LOCATION_STALE_AFTER_MS="300000"
FIELD_LOCATION_RETENTION_DAYS="30"

# Production backup/export storage
# These must be absolute paths on a durable, private, encrypted volume.
BACKUP_DATABASE_URL=""
BACKUP_DIR="/var/lib/sanghvi-erp/database-backups"
DAILY_ARCHIVE_DIR="/var/lib/sanghvi-erp/daily-archives"
BACKUP_RETENTION_DAYS="30"
PSQL_PATH="psql"

# Production restore safety
# Generate a separate 24+ character secret; never reuse CRON_SECRET.
RESTORE_CONFIRMATION_TOKEN=""

# First production bootstrap (run once, then remove the password from runtime env)
SEED_MODE="bootstrap"
SEED_OWNER_NAME="Sanghvi ERP Owner"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PHONE=""
SEED_INITIAL_PASSWORD=""

# Optional Google Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID=""
