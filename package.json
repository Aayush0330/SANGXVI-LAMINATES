{
  "name": "sanghvi-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run test && npm run lint && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:status": "node --import tsx scripts/check-migration-integrity.ts && prisma migrate status",
    "db:deploy": "node --import tsx scripts/deploy-migrations.ts",
    "db:seed": "prisma db seed",
    "db:backup": "node --import tsx scripts/backup-db.ts",
    "db:restore": "node --import tsx scripts/restore-db.ts",
    "db:backup:auto": "node --import tsx scripts/backup-db.ts --automatic",
    "db:backup:verify": "node --import tsx scripts/verify-backup.ts",
    "db:migrations:fresh-test": "node --import tsx scripts/verify-fresh-migrations.ts",
    "security:rotate-launch-passwords": "node --import tsx scripts/rotate-launch-passwords.ts",
    "reports:daily": "node --import tsx scripts/generate-daily-report.ts",
    "alerts:escalate": "node --import tsx scripts/escalate-alerts.ts",
    "reorder:alerts": "node --import tsx scripts/sync-reorder-alerts.ts",
    "calendar:connect": "node --import tsx scripts/google-calendar-connect.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
